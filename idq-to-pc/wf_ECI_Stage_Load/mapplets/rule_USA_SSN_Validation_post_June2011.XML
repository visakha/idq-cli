          <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION="" NAME="Out_SSN_Status" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="15" SCALE="0" MAPPLETGROUP="output" />

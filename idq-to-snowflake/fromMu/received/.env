# Copy to .env and fill in.  Never commit a real .env.
# API key: if set, clients must send X-API-Key: <value>.  Leave empty
# for local development only.
API_KEY=

# Local control store (job history only -- never ETL data).
CONTROL_DB_URL=sqlite:///./trs_compare.db

# Oracle (IDQ side) -- one user with SELECT on STAGING, HHS_MDM and RDM.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL
ORACLE_USER=
ORACLE_PASSWORD=

# Snowflake (comparison side).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# For authenticator=snowflake only:
SNOWFLAKE_PASSWORD=
# SSO: externalbrowser (local interactive use only) | oauth (server
# use, with SNOWFLAKE_OAUTH_TOKEN from your IdP) | snowflake.
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_OAUTH_TOKEN=
# Snowflake layout (v5.1): one database per source, one schema TRS_ETL_WRK,
# discriminator DATA_SOURCE ('IDQ' / 'SNOWFLAKE') on target tables.
#   SNOWFLAKE_SOURCE=TRS  -> database MDM_ETL_TRS, schema TRS_ETL_WRK
#   COMMON framework     -> database MDM_ETL_COMMON, schema COMMON
# Database/schema names are derived from SNOWFLAKE_SOURCE unless
# you set them explicitly below.
SNOWFLAKE_SOURCE=TRS
# SNOWFLAKE_DATABASE=MDM_ETL_TRS
# SNOWFLAKE_SCHEMA=TRS_ETL_WRK
# SNOWFLAKE_COMMON_DATABASE=MDM_ETL_COMMON
# SNOWFLAKE_COMMON_SCHEMA=COMMON
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Behaviour
COPY_BATCH_SIZE=5000
COMPARE_SAMPLE_LIMIT=20

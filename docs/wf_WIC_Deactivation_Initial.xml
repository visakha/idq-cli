<workflow:Workflow imx:id="U:8D4s8uJnEe-S6AkDGzPimA" firstInstance="U:8D4s8-JnEe-S6AkDGzPimA" name="wf_WIC_Deactivation_Initial">
<annotations>
<Annotation imx:id="ID_1" xsi:type="description:Description" body="Process+WIC+members+that+are+invalid+per+MDM+rules+by+correspondingly+soft+deleting+them+from+the+MDM.++%0D%0APrior+to+this+mapping+%28in+ongoing+mapping%29+Capture+invalid+WIC+parties+in+an+deactivation+log+table+in+HIP+staging+and+also+removing+them+from+the+valid+member+list.++New+data+in+the+deactivation+log+is+flagged+as+unprocessed+%0D%0A%0D%0AWork+flow+mapping+step+are+as+follows%09+%0D%0A%091%29+Copy+all+deactivated+source+keys+from+HIP+staging+to+an+MDM+table+%0D%0A%092%29+Using+the+MDM+table+above%2C+1st+unmerge+the+source+keys+from+the+BO%2C+then+create+soft+delete+records+%28hib_state_ind+%3D+-1%29+in+the+MDM+staging+tables+for+all+parties+and+their+child+tables.++%0D%0A%09%09These+records+will+be+ADDED+to+the+MDM+statging+table+and+will+be+processed+as+part+of+normal+batch+processing%0D%0ANOTE+this+job+is+re-runable+but+will+attempt+to+re-populate+the+MDM+staging+tables+if+re-run.++If+soft+delete+records+already+exist+it+will+fail+with+a+duplicate+key+error.%0D%0A%0D%0A%5BMLayne+9%2F2%2F2025%5D+Changed+unmerge+and+soft+delete+from+web+service+to+command+call."/>
</annotations>
